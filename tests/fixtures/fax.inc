/* CCITT fax fixtures: two bilevel patterns encoded by libtiff 4's
 * tiffcp (-c g4, g3:1d, g3:2d, g3:2d:fill), so the decoder is checked
 * against another's encoder, not its own.  fax_pixel() draws the source
 * of each, 1 for black.  Shared by the kit's fax test and the PDF one.
 * SPDX-License-Identifier: Apache-2.0 */

#define FAX_SMALL_W 150
#define FAX_SMALL_H 24
#define FAX_WIDE_W  2700
#define FAX_WIDE_H  6

/** @brief Pixel (x, y) of the small (150 by 24) or the wide (2700 by 6)
 *         pattern: rows of every kind of change, runs past 1792. */
static int
fax_pixel(int wide, int x, int y)
{
    if (wide) {
        if (y == 0) return x >= 2600;
        if (y == 1) return x < 2590;
        if (y == 2) return x >= 5 && x < 1900;
        if (y == 3) return x % 1000 < 3;
        return x >= 64 && x < 64 + 1792 + 64;
    }
    if (y == 0) return 0;
    if (y == 1) return 1;
    if (y == 2) return x < 70;
    if (y == 3) return (x / 3) % 2;
    if (y < 12) {
        return (x - 5 * y > -2 && x - 5 * y < 2) ||
               (x - (140 - 7 * y) > -3 && x - (140 - 7 * y) < 3);
    }
    if (y < 18) {
        return x >= 20 && x < 130 && !(x >= 50 && x < 90 && y >= 14);
    }
    return (x - 75) * (x - 75) + (y - 21) * (y - 21) * 16 < 900;
}

